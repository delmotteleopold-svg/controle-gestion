# En-têtes HTTP pour Cloudflare Pages ou Netlify (dossier publié : salle-assiette/).
# Ignoré par GitHub Pages.

# Le service worker et le manifest doivent toujours être revérifiés,
# sinon les mises à jour de l'appli peuvent mettre jusqu'à 24 h à arriver.
/sw.js
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
  Content-Type: application/manifest+json
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/icons/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=()
